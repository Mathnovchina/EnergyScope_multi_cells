@article{tomvanflandernWhatGlobalPositioning2003,
	title = {What the {Global} {Positioning} {System} {Tells} {Us} about the {Twin}’s {Paradox}},
	url = {http://redshift.vif.com/JournalFiles/V10NO1PDF/V10N1TVF.pdf},
	abstract = {In the GPS, all atomic clocks in all reference frames (in orbit and on the ground) are set once and stay synchronized. We can use this same trick to place a GPS-type clock aboard the spacecraft of a traveling twin. That clock will stay synchronized with Earth clocks, allowing a clear resolution of the twin’s paradox in special relativity—why the traveller expects to come back younger, and why the stay-at-home twin is not entitled to the same expectation.},
	urldate = {2022-11-29},
