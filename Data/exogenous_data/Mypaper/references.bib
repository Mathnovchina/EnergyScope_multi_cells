@article{roddisEcoinnovationReduceBiodiversity2018,
	title = {Eco-innovation to reduce biodiversity impacts of wind energy: {Key} examples and drivers in the {UK}},
	volume = {28},
	issn = {2210-4224},
	shorttitle = {Eco-innovation to reduce biodiversity impacts of wind energy},
	doi = {10.1016/j.eist.2018.03.003},
	abstract = {Wind energy technologies deliver environmental benefits in terms of reduced greenhouse gas emissions. However, they can entail other environmental impacts such as on biodiversity. This article identifies fifteen examples of innovation in the UK wind energy sector that address biodiversity impacts, and seven drivers behind these innovations. Examples are categorised into six thematic areas covering eco-process, eco-organisational and eco-product innovations. Eco-process and eco-organisational innovations are found to be most sensitive to institutional and political influences (such as regulation), whilst eco-product innovations are most sensitive to supply-side factors (such as cost-saving). These findings contribute to theoretical debates on the determinants of eco-innovation, as well as having implications for policymakers addressing the dual policy objectives of renewable energy deployment and biodiversity conservation.},
	urldate = {2024-07-03},
	journal = {Environmental Innovation and Societal Transitions},
	author = {Roddis, Philippa},
	month = sep,
	year = {2018},
	keywords = {Biodiversity, Eco-innovation, Innovation, Renewable energy, Wildlife, Wind energy, notion},
