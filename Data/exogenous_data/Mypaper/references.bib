	author = {Helmers, Eckard and Marx, Patrick},
	month = apr,
	year = {2012},
	keywords = {Battery electric vehicles, CO2, Electric conversion, Fuel cell vehicles, Global warming potential, Internal combustion engine vehicle, Life cycle assessment, Plug-in hybrid electric vehicle, Sustainable mobility, Traffic emissions},
