	pages = {33--41},
}

@article{QuestceQuePropriete2023,
	title = {\textit{{Qu}'est-ce que la propriété ?}},
	abstract = {Qu'est-ce que la propriété ? ou Recherche sur le principe du Droit et du Gouvernement, publié le 30 juin 1840, est le premier ouvrage majeur de l'anarchiste français Pierre-Joseph Proudhon. Il traite du concept de propriété et de sa relation avec l'État, les ouvriers et l'anarchisme. Ce livre contient la citation célèbre : « La propriété, c'est le vol ! » Proudhon déclare : « J'en ferai sortir la preuve irréfragable que la propriété, quand elle serait juste et possible, aurait pour condition nécessaire l'égalité. » Il adopte le mot mutuellisme pour décrire sa vision d'une économie composée d'individus et de syndicats démocratiques qui échangeraient leurs produits sous la contrainte de l'égalité. Bien que Karl Marx ait plus tard sévèrement critiqué Proudhon, il crédita néanmoins ce livre d'être le « manifeste du prolétariat français » et de l'avoir convaincu de la nécessité d'abolir la propriété privée.},
	language = {french},
	urldate = {2023-02-15},
	journal = {Wikipédia},
	month = jan,
	year = {2023},
	note = {tex.copyright: Creative Commons Attribution-ShareAlike License},
}

