@book{directorate-generalformobilityandtransporteuropeancommissionEUTransportFigures2025,
	title = {{EU} transport in figures: statistical pocketbook 2025},
	isbn = {978-92-68-29316-4},
	shorttitle = {{EU} transport in figures},
	url = {https://data.europa.eu/doi/10.2832/2584130},
	abstract = {Transport represents a crucial sector of the economy. This publication provides an overview of the most recent and most pertinent annual transport-related statistics in Europe. It covers the European Union and its 27 Member States (EU-27) and, as far as possible, the current EU candidate countries, the EFTA countries and UK. The content of this pocketbook is based on a range of sources including Eurostat, international organisations and associations, national statistics and, where no data were available, own estimates. Own estimates have mainly been produced to get an idea of the EU total. At the level of individual countries, they are merely indicative and should by no means be interpreted as official data.},
	language = {eng},
	urldate = {2025-12-02},
	publisher = {Publications Office of the European Union},
	author = {{Directorate-General for Mobility and Transport
                
