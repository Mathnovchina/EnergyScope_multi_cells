	doi = {10.55161/JVYW3199},
	abstract = {Global climate change, the conversion of large areas of tropical forest to agriculture and rangelands, and forest degradation driven by wildfires are pushing the Amazon towards irreversible thresholds, often called tipping points. We need an immediate deforestation moratorium in areas more likely to cross a tipping point (e.g., Southern Amazon), and in protected areas and Indigenous territories; so that there is zero deforestation in the Amazon by 2030.},
	language = {english},
	urldate = {2024-02-28},
	institution = {Sustainable Development Solutions Network (SDSN)},
	author = {Hirota, Marina and Nobre, Carlos A. and Alencar, Ane and Areiera, Julia and De Assis Costa, Francisco and Flores, Bernardo and Gandour, Clarissa and Josse, Carmen and Levis, Carolina and Póveda, German and Young, Carlos Eduardo F.},
	month = nov,
