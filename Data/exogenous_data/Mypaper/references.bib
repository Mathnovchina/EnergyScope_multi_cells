@article{dalessandroExploringPolicyResponses2025,
	title = {Exploring policy responses to labour-saving technologies: {An} assessment of basic income, job guarantee, and working time reduction},
	volume = {47},
	issn = {01618938},
	shorttitle = {Exploring policy responses to labour-saving technologies},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0161893825000043},
	doi = {10.1016/j.jpolmod.2025.01.001},
	abstract = {This study examines policy responses to labor-saving technologies, focusing on employment and income inequality. Using the EUROGREEN model, we assess three scenarios: basic income, job guarantee, and working time reduction. The job guarantee scheme effectively reduces unemployment but raises the fiscal deficit, while working time reduction improves wage share, cuts deficits, and reduces inequality. Basic income has a moderate impact on unemployment but significantly reduces inequality but is accompanied by higher deficits. A wealth tax could help finance these policies and contribute to inequality reduction. This research provides novel insights to policymakers by demonstrating how a strategic mix of labour policies can improve socio-economic outcomes in the face of technological-induced job disruptions.},
	language = {en},
	number = {1},
	urldate = {2025-03-28},
	journal = {Journal of Policy Modeling},
	author = {D’Alessandro, Simone and Distefano, Tiziano and Spinato Morlin, Guilherme and Villani, Davide},
