@article{dangeloGreenManufacturingSustainable2023,
	title = {Green manufacturing for sustainable development: {The} positive effects of green activities, green investments, and non-green products on economic performance},
	volume = {32},
	copyright = {© 2022 The Authors. Business Strategy and The Environment published by ERP Environment and John Wiley \& Sons Ltd.},
	issn = {1099-0836},
	shorttitle = {Green manufacturing for sustainable development},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bse.3226},
	doi = {10.1002/bse.3226},
	abstract = {This article explores the impact of green manufacturing practices, disentangled in green activities, green investments, and the type of product made, on the economic performance of firms. Using survey data collected by European Commission from European small- and medium-sized enterprises (SMEs), we adopt the self-determination theory to investigate the extent to which the number of green activities, green investments, and type of product made affects a firm's economic performance. We argue that consumers are affected by firms' green manufacturing practices in response to the pressing environmental issues affecting our era. Our results reveal that while the number of green activities has a positive effect on economic performance, the amount of green manufacturing investments has an inverted U-shaped relationship to economic performance and that this effect is positively moderated if a company also sells non-green products. Our study contributes to the literature on green manufacturing by dissecting the effect of green manufacturing practices on a company's economic performance. Our findings also provide managers with advice on the right balance of green practices that most benefit their companies.},
	language = {en},
	number = {4},
	urldate = {2023-08-29},
	journal = {Business Strategy and the Environment},
	author = {D'Angelo, Viviana and Cappa, Francesco and Peruffo, Enzo},
	year = {2023},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/bse.3226},
	keywords = {economic performance, green activities, green investments, green manufacturing, green practices, green product},
	pages = {1900--1913},
}

