@article{cesarattoMoralityAlternativeEconomic2024,
	title = {Morality and {Alternative} {Economic} {Theories} in {Ancient} {History} {Studies}: a {Review} {Article}},
	abstract = {Models, Methods, and Morality discusses moral values in the ﬁeld of ancient economic history, where neoclassical hegemony in the form of the New InsƟtuƟonal Economics has progressively gained ground. The book mainly criƟcises mainstream economics for focusing on quanƟtaƟve growth without much regard to its social consequences. The spirit of this review is a construcƟve encouragement to build an alternaƟve approach to economic history possibly based on the classical economists’ surplus approach, taking also advantage of the familiarity that scholars of ancient socieƟes have with the concept of economic surplus. The risk is that without a resolute criƟcism of mainstream economics and the adopƟon of an alternaƟve point of view, mainstream economics might paternalisƟcally reabsorb the legiƟmate moral criƟcism that pervades many of the contribuƟons to the volume. Being based on a simple heurisƟc of the economic sources of the élites’ wealth and not possessing a pre-packaged view of human behaviour, surplus theory may usefully be at the core of a socially sensiƟve, economic history agenda.},
	language = {en},
	journal = {QUADERNI DEL DIPARTIMENTO  DI ECONOMIA POLITICA E STATISTICA},
	author = {Cesaratto, Sergio},
	year = {2024},
	keywords = {⛔ No DOI found},
}

