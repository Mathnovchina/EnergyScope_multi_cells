@article{bernothCYCLICALITYAUTOMATICDISCRETIONARY2015,
	title = {{THE} {CYCLICALITY} {OF} {AUTOMATIC} {AND} {DISCRETIONARY} {FISCAL} {POLICY}: {WHAT} {CAN} {REAL}-{TIME} {DATA} {TELL} {US}?},
	volume = {19},
	issn = {1365-1005, 1469-8056},
	shorttitle = {{THE} {CYCLICALITY} {OF} {AUTOMATIC} {AND} {DISCRETIONARY} {FISCAL} {POLICY}},
	url = {https://www.cambridge.org/core/product/identifier/S1365100513000369/type/journal_article},
	doi = {10.1017/S1365100513000369},
	abstract = {This paper develops a new methodology for estimating both the automatic and discretionary components of ﬁscal policy in one reaction function using the differences between real-time and ex post data. Discretionary policy should respond to information available to the policy maker at the time (real-time data), whereas automatic ﬁscal policy should respond to the true state of the economy at the time (proxied by the ﬁnal data). We ﬁnd that the intended discretionary response of ﬁscal policy to the cycle is counter-cyclical. Our estimates suggest that the automatic stabilizers are at the lower end of the range found in the related literature. This new methodology reduces the risk present in the conventional CAB approach that part of the discretionary actions may be wrongly attributed to automatic stabilizers. In that sense, automatic stabilizers are typically not as strong as usually claimed. This could be of particular use in countries where insufﬁcient data exist to estimate structural budget sensitivities directly.},
	language = {en},
	number = {1},
	urldate = {2023-05-26},
	journal = {Macroeconomic Dynamics},
	author = {Bernoth, Kerstin and Hughes Hallett, Andrew and Lewis, John},
	month = jan,
	year = {2015},
	pages = {221--243},
}

@misc{auerbachFiscalStimulusFiscal2017,
	type = {Working {Paper}},
	series = {Working {Paper} {Series}},
	title = {Fiscal {Stimulus} and {Fiscal} {Sustainability}},
	url = {https://www.nber.org/papers/w23789},
	doi = {10.3386/w23789},
	abstract = {The Great Recession and the Global Financial Crisis have left many developed countries with low interest rates and high levels of public debt, thus limiting the ability of policymakers to fight the next recession. Whether new fiscal stimulus programs would be jeopardized by these already heavy public debt burdens is a central question. For a sample of developed countries, we find that government spending shocks do not lead to persistent increases in debt-to-GDP ratios or costs of borrowing, especially during periods of economic weakness. Indeed, fiscal stimulus in a weak economy can improve fiscal sustainability along the metrics we study. Even in countries with high public debt, the penalty for activist discretionary fiscal policy appears to be small.},
	urldate = {2023-05-26},
	publisher = {National Bureau of Economic Research},
	author = {Auerbach, Alan J. and Gorodnichenko, Yuriy},
	month = sep,
	year = {2017},
	doi = {10.3386/w23789},
}

