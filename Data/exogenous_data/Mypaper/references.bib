@article{martinspachecoCarbonTaxationInstrument2022a,
	title = {Carbon {Taxation} as {An} {Instrument} to {Promote} {Wildfire} {Prevention} and {Avoid} {Biodiversity} {Loss} in {Portugal}: {An} {Order} of {Magnitude} {Analysis}},
	volume = {3},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	shorttitle = {Carbon {Taxation} as {An} {Instrument} to {Promote} {Wildfire} {Prevention} and {Avoid} {Biodiversity} {Loss} in {Portugal}},
	url = {https://www.lidsen.com/journals/aeer/aeer-03-04-051},
	doi = {10.21926/aeer.2204051},
	abstract = {Climate change is one of the main challenges of the current century. Emissions taxes are one of the proposed ways to help in addressing this issue. In this sense, Portugal has introduced an Addition Tax on Carbon Emissions through Law N. 82-D/2014. One of the most notorious impacts of climate change in the country is the wildfires increasing in frequency and intensity. Forests provide various ecosystem services not valued by traditional markets, such as carbon sequestration. Recently, Portugal has created new environmental policies that deal with fire prevention and biodiversity conservation through payment for ecosystem services schemes. In this context, the objective of this work was to perform an order of magnitude analysis of the revenue from the Addition Tax on Carbon Emissions (Law N. 82-D/2014) and contrast it with the investment costs of RCM N. 121/2019 (Payment for Ecosystem Services) and of RCM N. 59/2017 (Prescribed Burning Program). The results indicated that the Addition Tax revenue was much greater than the costs of the other two policies combined, even if expanding the use of prescribed burning in the country. This suggested that these policies can work synergistically, as development agendas recommend, such as the Sustainable Development Goals. This analysis framework might be helpful for other countries, especially in the Mediterranean Basin.},
	language = {en},
	number = {4},
	urldate = {2024-04-22},
	journal = {Advances in Environmental and Engineering Research},
	publisher = {LIDSEN Publishing Inc},
	author = {Martins Pacheco, Renata},
	month = dec,
	year = {2022},
	note = {Number: 4},
	pages = {1--5},
}

@article{waldUberEinigeGleichungssysteme1936a,
	title = {Über einige {Gleichungssysteme} der mathematischen Ökonomie},
	volume = {7},
	issn = {0044-3158},
	url = {https://www.jstor.org/stable/41793196},
	abstract = {L'auteur examine la question de la solubilité des équations de production et d'échange, puis le duopole de Cournot. Dans l'économie mathématique l'on a supposé la solubilité d'un système d'équations en établissant toujours l'accord du nombre des équations avec celui des inconnues. L'auteur démontre que la solubilité de ces équations ne peut être soutenue sans quelques suppositions additionnelles; et puis il discute les conditions qui garantissent leur solubilité, ou leur solubilité unique. Les preuves de la solubilité de ces équations sous les dites conditions exigent des arguments mathématiques les plus approfondis qui se servent de tous les moyens de la mathématique moderne. The author examines the question of the solubility of the equations of production and of exchange, and then the duopoly of Cournot. In mathematical economics, the solubility of a system of equations was assumed always by establishing the correspondence of the number of equations and that of unknowns. The author demonstrates that the solubility of these equations cannot be maintained without several additional assumptions; and he discusses then the conditions which guarantee their solubility, or their unique solubility. The proofs of the solubility of these equations under the said conditions require most complicated mathematical arguments making use of all the resources of modern mathematics.},
	number = {5},
	urldate = {2023-02-17},
	journal = {Zeitschrift für Nationalökonomie / Journal of Economics},
	publisher = {Springer},
	author = {Wald, A.},
	year = {1936},
	pages = {637--670},
}

