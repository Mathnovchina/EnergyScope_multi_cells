@book{nunesHandbookEconomicsEcosystem2014a,
	title = {Handbook on the {Economics} of {Ecosystem} {Services} and {Biodiversity}},
	url = {http://search.ebscohost.com/login.aspx?direct=true&db=ecn&AN=1516619&lang=fr&site=ehost-live},
	abstract = {Thirty papers present current developments in the economic analysis of ecosystem services and identify key research needs that need to be addressed in order to move the field forward. Papers focus on setting the scene--the need for ecosystem service valuation; emerging economic valuation methods, including the use of deliberative, macro, and spatially explicit economic valuation; ecosystem services and conservation policy; shedding light on nonmarket values of ecosystem services; and the role of governance and science-policy-business interface in bringing visible ecosystem values. Nunes is Scientific Coordinator of the Policy and Technical Expert Committee of the World Bank. Kumar is Chief of the Ecosystem Services Economic Unit at the United Nations Environment Programme. Dedeurwaerdere is Director of the Biodiversity Governance Unit of the Centre for the Philosophy of Law and Professor of Philosophy of Science at the Universite Catholique de Louvain. Index.},
	publisher = {Cheltenham, UK and Northampton, MA:},
