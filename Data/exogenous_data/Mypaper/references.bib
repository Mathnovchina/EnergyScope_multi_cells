	keywords = {Biodiversity Conservation, Bioeconomics, Ecological Economics: Ecosystem Services, Economic Development: Agriculture, Energy, Environment, Environment and Growth O44, Environmental Economics: Government Policy Q58, Industrial Ecology Q57, Measurement and Analysis of Poverty I32, Natural Resources, Other Primary Products O13},
