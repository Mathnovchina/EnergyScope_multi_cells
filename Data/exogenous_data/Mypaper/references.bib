	keywords = {Biodiversity Conservation, Bioeconomics, Climate, Ecological Economics: Ecosystem Services, Environmental Economics: Government Policy Q58, General Welfare, Global Warming Q54, Industrial Ecology Q57, Natural Disasters and Their Management, Renewable Resources and Conservation: Forestry Q23, Well-Being I31},
	pages = {60--73},
}

@article{mitchellIncorporatingGovernanceInfluences2015a,
