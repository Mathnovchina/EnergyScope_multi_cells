	urldate = {2023-06-02},
	journal = {Academy of Management Proceedings},
	publisher = {Academy of Management},
	author = {Delmas, Magali and Pekovic, Sanja},
	month = jan,
	year = {2013},
	keywords = {green capital, labor productivity, notion, social capital},
	pages = {10483},
}

