@article{dafermosAssessingClimatePolicies2022,
	chapter = {European Journal of Economics and Economic Policies},
	title = {Assessing climate policies: an ecological stock–flow consistent perspective},
	shorttitle = {Assessing climate policies},
	url = {https://www.elgaronline.com/view/journals/ejeep/19/3/article-p338.xml},
	doi = {10.4337/ejeep.2022.0095},
	abstract = {Addressing the climate crisis requires a deep socio-ecological transformation of our economies. This transformation involves the implementation of climate policies that not only transform standard macroeconomic and financial tools but also lead to sufficiency-based consumption patterns. The assessment and design of such policies require a systems-based approach that is not restricted by the straightjacket of cost–benefit analysis. In this paper, the authors employ an ecological stock–flow consistent model to provide a systems-based evaluation of certain macroeconomic, financial and sufficiency policies for climate mitigation. They show how the use of such an approach allows them to identify policy mixes that have the potential to address the climate crisis without undermining macrofinancial and social stability.},
	language = {en},
	urldate = {2025-08-19},
	author = {Dafermos, Yannis and Nikolaidi, Maria},
	month = oct,
	year = {2022},
	keywords = {E12, E44, E52, E62, Q54, Q57, climate change, consumption patterns, ecological stock–flow consistent modelling, green macroeconomic and financial policies},
}

