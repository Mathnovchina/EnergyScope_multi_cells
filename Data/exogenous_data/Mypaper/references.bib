	title = {Is an {Employer}-of-{Last}-{Resort} {Policy} {Sustainable}? {A} review article},
	volume = {12},
	issn = {0953-8259, 1465-3982},
	shorttitle = {Is an {Employer}-of-{Last}-{Resort} {Policy} {Sustainable}?},
