@article{andrianadyHeatEconomicsClimate2023,
	title = {Heat and {Economics}: {Climate} {Change}’s {Influence} on {Madagascar}’s {GDP}},
	issn = {1556-5068},
	shorttitle = {Heat and {Economics}},
	url = {https://www.ssrn.com/abstract=4561001},
	doi = {10.2139/ssrn.4561001},
	abstract = {Employing a VAR model, this work delves into Madagascar’s economic dynamics, particularly its GDP growth, agricultural production, and land use, with a pronounced emphasis on the profound in uence of temperature uctuations. The results illuminate the intricate interplay between economic activities and climatic variations, emphasizing the susceptibility of the economy to temperature changes. This underscores the urgency of formulating adaptive strategies that mitigate the adverse e ects of temperature uctuations, enabling not only economic growth but also environmental sustainability—a synergy crucial for Madagascar’s prosperous future.},
	language = {en},
